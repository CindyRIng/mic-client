{
  "name": "mic-client",
  "version": "1.0.0",
  "private": false,
  "description": "Made-in-China.com local client: REST API / CLI / MCP for supplier search & company profiles, with SQLite cache, region modes and Focus Captcha autosolve",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "mic": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "data",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "serve": "node dist/cli.js serve",
    "mcp": "node dist/cli.js mcp",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist coverage",
    "smoke:live": "node scripts/e2e/live-smoke.mjs",
    "smoke:mcp": "node scripts/e2e/mcp-smoke.mjs",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^13.2.0",
    "cloakbrowser": "0.6.5",
    "commander": "^14.0.0",
    "fastify": "^5.2.0",
    "playwright-core": "1.65.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "homepage": "https://github.com/CindyRIng/mic-client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CindyRIng/mic-client.git"
  },
  "bugs": {
    "url": "https://github.com/CindyRIng/mic-client/issues"
  },
  "author": "CindyRIng and MIC Client contributors",
  "keywords": [
    "made-in-china",
    "b2b",
    "supplier-search",
    "factory-search",
    "cli",
    "rest-api",
    "mcp",
    "model-context-protocol",
    "sqlite",
    "captcha",
    "scraping",
    "china"
  ]
}
